PORT=3000

# Domain registered on your Apple Pay merchant ID (no protocol).
MERCHANT_DOMAIN=localhost

# Display name as it appears in the Apple Pay sheet.
MERCHANT_DISPLAY_NAME=Demo Coffee Shop

# Merchant identifier from Apple Developer > Identifiers > Merchant IDs.
MERCHANT_IDENTIFIER=merchant.com.apdemo

# Paths to the merchant identity certificate and key (PEM format).
MERCHANT_CERT_PATH=certs/merchant_id_cert.pem
MERCHANT_KEY_PATH=certs/merchant_id_key.pem
MERCHANT_KEY_PASSPHRASE=

# TLS cert/key used by the local HTTPS server (can be mkcert generated).
DEV_SSL_CERT_PATH=certs/dev-cert.pem
DEV_SSL_KEY_PATH=certs/dev-key.pem
DEV_SSL_KEY_PASSPHRASE=

